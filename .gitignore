# === ML experiment artifacts (regenerated from code) ===
# Submissions from local experiments
ecup26-user-value/submissions/

# Catboost training artifacts
ecup26-user-value/catboost_info/

# Pre-processed feature caches (regenerable from train.parquet + code)
ecup26-user-value/data/cache/
ecup26-user-value/data/.cache/features_*.parquet
ecup26-user-value/data/.cache/train_*.parquet
ecup26-user-value/data/folds/
ecup26-user-value/data/sequences/
ecup26-user-value/data/static/

# Whitelist specific datasets / models to be tracked via git-lfs
# (overrides the *.parquet / *.csv / *.pt rules above)
!ecup26-user-value/data/train.parquet
!ecup26-user-value/data/sample_submit.csv
!ecup26-user-value/data/submit.csv
!ecup26-user-value/data/baseline-seacrh-ltv.ipynb
!ecup26-user-value/data/.cache/model_*.txt
!ecup26-user-value/models/neural/*.pt

# Data directories — structure kept, content ignored
# scripts/ are committed
# docs/ are committed
# tasks/ are committed
# models/ — neural/*.pt tracked via LFS, others ignored
